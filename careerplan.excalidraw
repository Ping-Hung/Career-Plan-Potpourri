    {
      "id": "nEhtzrdh0ERmqNFqPNQmS",
      "type": "text",
      "x": -346.83743966536395,
      "y": -84.10223388671864,
      "width": 343.774705697265,
      "height": 456.2660725911458,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
